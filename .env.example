# Copy to .env (gitignored) and fill in what you need. claimci reads it from the repo root,
# locally and on a remote box; variables already set in your shell win.
ANTHROPIC_API_KEY=   # ingest, match, judge, and rerunning judged claims
HF_TOKEN=            # gated models (gemma-2b-it, Llama-2); or run `hf auth login` once
